+import { CameraFingerprint, fingerprintKey } from './fingerprint';
+
+type CameraIdentity = {
+    driver: string;
+    fingerprint?: CameraFingerprint | null;
+};
+
+export const matchesCameraHardware = (camera: CameraIdentity, hardware: CameraIdentity): boolean => {
+    if (camera.driver !== hardware.driver) return false;
+
+    const saved = camera.fingerprint;
+    const discovered = hardware.fingerprint;
+    if (!saved || !discovered) return false;
+    if (fingerprintKey(saved) === fingerprintKey(discovered)) return true;
+    if (camera.driver !== 'usb_camera') return false;
+
+    if (
+        typeof saved.serial !== 'string' ||
+        saved.serial.trim().length === 0 ||
+        saved.serial !== discovered.serial ||
+        typeof saved.bus !== 'string' ||
+        saved.bus.trim().length === 0 ||
+        saved.bus !== discovered.bus ||
+        typeof saved.sensor !== 'string' ||
+        saved.sensor !== discovered.sensor
+    ) {
+        return false;
+    }
+
+    // A USB device can expose several stream nodes. Only presence may ignore the node index;
+    // stream selection still needs the saved fingerprint, including its original index.
+    const withoutIndex = (fingerprint: CameraFingerprint): CameraFingerprint =>
+        Object.fromEntries(Object.entries(fingerprint).filter(([key]) => key !== 'index'));
+
+    return fingerprintKey(withoutIndex(saved)) === fingerprintKey(withoutIndex(discovered));
+};
